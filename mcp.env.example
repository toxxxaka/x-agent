# Copy outside the repository, replace values, then chmod 600 it.
# Generate a unique 32+ character token, for example: openssl rand -hex 32
X_AGENT_MCP_TOKEN=replace-with-a-unique-32-character-or-longer-secret
X_AGENT_X_USERNAME=your_x_handle
# Keep the MCP service loopback-only unless it is protected by a reverse proxy.
X_AGENT_MCP_HOST=127.0.0.1
X_AGENT_MCP_PORT=8765
# Optional state paths. Defaults are under ~/.local/state/x-agent.
# X_AGENT_DB_PATH=/var/lib/x-agent/operations.sqlite3
# X_AGENT_DEBUG_LOG=/var/lib/x-agent/x-agent.log
