[Unit]
Description=Private X Agent MCP endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xagent
WorkingDirectory=/srv/x-agent
EnvironmentFile=/etc/x-agent/mcp.env
Environment=X_AGENT_MEDIA_STAGE_DIR=/var/lib/x-agent/media
ExecStart=/srv/x-agent/.venv/bin/python3 -m x_agent.mcp_http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ReadWritePaths=/var/lib/x-agent

[Install]
WantedBy=multi-user.target
