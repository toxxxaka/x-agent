[Unit]
Description=Private X Agent MCP endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/x-agent
EnvironmentFile=/etc/x-agent/mcp.env
Environment=X_AGENT_MEDIA_STAGE_DIR=/root/snap/chromium/common/x-agent-media
ExecStart=/opt/x-agent/venv/bin/python3 -m x_agent.mcp_http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
BindPaths=/root/snap/chromium/common/x-agent-media
ReadWritePaths=/opt/x-agent /var/lock /root/snap/chromium/common/x-agent-media

[Install]
WantedBy=multi-user.target
